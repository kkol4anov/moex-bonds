# --- Database ---
# Local dev: matches the credentials in docker-compose.yml
# Render: paste the connection string from the dashboard here.
# postgresql:// is fine — config.py rewrites it to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql://postgres:pass@localhost:5432/moex_bonds

# --- MOEX ISS ---
ISS_BASE_URL=https://iss.moex.com/iss

# --- Logging ---
LOG_LEVEL=INFO